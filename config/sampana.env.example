# Copier en config/sampana.env puis adapter. Ce fichier-ci est versionne,
# config/sampana.env ne l'est pas (il contient ton hostname).

# Nom d'hote Tailscale de la machine (tailscale status --json | jq -r .Self.DNSName)
SAMPANA_HOST=ma-machine.exemple.ts.net

# Port local de Caddy. N'ecoute que sur 127.0.0.1, expose ensuite par Tailscale.
CADDY_PORT=8088

# Port local du service de sante agrege (stdlib Python, sans dependance).
HEALTH_PORT=8089

# Authentification par mot de passe maitre unique.
# Le mot de passe est demande UNE fois et vaut pour tous les services, y compris
# ceux servis sur leur propre port : la session est un cookie, et les cookies
# ignorent le numero de port.
AUTH_ENABLED=1
AUTH_PORT=8090

# Terminal web ttyd.
TTYD_PORT=7681

# Racine servie par Caddy pour les fichiers statiques du dashboard.
WEB_ROOT=/srv/sampana
