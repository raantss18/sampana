# Copier en config/sampana.env puis adapter. Ce fichier-ci est versionne,
# config/sampana.env ne l'est pas (il contient ton hostname).

# Nom d'hote Tailscale de la machine (tailscale status --json | jq -r .Self.DNSName)
SAMPANA_HOST=hote.tailnet.ts.net

# Port local de Caddy, expose ensuite par Tailscale.
CADDY_PORT=8088

# Interface d'ecoute du dashboard enseignant. 0.0.0.0 le rend joignable depuis
# le reseau local en plus du tailnet — le mot de passe maitre reste exige, et
# auth.py applique un ralentissement progressif sur les tentatives ratees.
CADDY_BIND=0.0.0.0

# Port local du service de sante agrege (stdlib Python, sans dependance).
HEALTH_PORT=8089

# Terminal web ttyd.
TTYD_PORT=7681

# Racine servie par Caddy pour les fichiers statiques du dashboard.
WEB_ROOT=/srv/sampana

AUTH_ENABLED=1
AUTH_PORT=8090

# ── Mode invite ────────────────────────────────────────────────────
# Acces sans compte et sans persistance, pour les etudiants. Contrairement au
# reste de Sampana, ce site ECOUTE SUR LE LAN (c'est le but) et peut etre
# publie sur Internet via Tailscale Funnel.
GUEST_ENABLED=1

# Portail invite (chooser, saisie du code). Ecoute sur 127.0.0.1.
GUEST_GATE_PORT=8092

# Site Caddy invite. SEUL point de Sampana lie a une adresse routable.
GUEST_PORT=8081
GUEST_BIND=0.0.0.0

# Funnel n'accepte que 443, 8443 et 10000. 443 est le dashboard tailnet, il
# reste donc 10000 (portail + Jupyter + Lean) et 8443 (LaTeX Lab, qui exige
# la racine d'un port a lui). D'ou le deplacement d'AI Assist hors de 8443.
GUEST_FUNNEL_PORT=10000

# Duree d'une session invitee, en secondes (2 h).
GUEST_TTL=7200

# Compte LaTeX Lab partage par les invites, purge chaque nuit.
GUEST_LATEX_EMAIL=invite@sampana.local

# Dossier partage : l'enseignant y ecrit, les invites le lisent seulement.
# Place hors de /home : Caddy tourne sous son propre utilisateur et ne peut
# pas traverser /home/raantss (mode 0710).
GUEST_SHARE_DIR=/srv/sampana-partage

# Mot de passe du compte LaTeX Lab partage. Affiche aux invites (ils en ont
# besoin) et dans les consignes du tableau de bord enseignant.
GUEST_LATEX_PASSWORD=change-moi-au-premier-demarrage
